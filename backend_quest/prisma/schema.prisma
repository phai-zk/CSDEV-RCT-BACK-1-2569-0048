generator client {
  provider = "prisma-client"
  output   = "../src/db/generated"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id        Int         @id @default(autoincrement())
  username  String      @unique
  password  String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now())
  lostItems PostItems[]
}

model PostItems {
  id          Int        @id @default(autoincrement())
  type        ItemStatus @default(LOST)
  title       String
  description String?
  location    String
  eventDate   DateTime
  status      PostStatus @default(OPEN)
  image       String
  owner       Int
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now())
  ownerId     Users      @relation(fields: [owner], references: [id], onDelete: Cascade)
}

enum ItemStatus {
  LOST
  FOUND
}

enum PostStatus {
  OPEN
  CLOSED
}
